{
  "name": "TravelIt RC1 temporary iPhone preview - synthetic only",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "TravelIt RC1 synthetic QA preview",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "nohup node scripts/serve-rc1-preview.mjs > /tmp/travelit-rc1-preview.log 2>&1 < /dev/null &"
}
